# Default deny: only source and explicitly reviewed project documents are tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/consistency.yml
!/.github/actions/
/.github/actions/*
!/.github/actions/setup-toolkit/
/.github/actions/setup-toolkit/*
!/.github/actions/setup-toolkit/action.yml
!/docs/
/docs/*
!/docs/*.svg
!/outputs/
/outputs/*
!/outputs/一亩三分地本地工具/
/outputs/一亩三分地本地工具/*
!/outputs/一亩三分地本地工具/*.py
!/outputs/一亩三分地本地工具/architecture.json
!/outputs/一亩三分地本地工具/answers.json
!/outputs/一亩三分地本地工具/mood-phrases.json
!/outputs/一亩三分地本地工具/account.example.json
!/outputs/一亩三分地本地工具/requirements.txt
!/outputs/一亩三分地本地工具/README.md
!/outputs/一亩三分地本地工具/tokens.css
!/outputs/一亩三分地本地工具/reader.css
!/outputs/一亩三分地本地工具/reader.js
!/outputs/一亩三分地本地工具/reader.html
!/outputs/一亩三分地本地工具/运行.cmd
!/outputs/一亩三分地本地工具/检查.cmd
!/outputs/一亩三分地本地工具/运行.sh
!/outputs/一亩三分地本地工具/检查.sh
!/outputs/一亩三分地本地工具/tests/
/outputs/一亩三分地本地工具/tests/*
!/outputs/一亩三分地本地工具/tests/test_*.py

# Never version runtime state or generated files, even under an allowed directory.
**/__pycache__/
**/*.py[cod]
**/.env*
**/*.dpapi
**/*.sqlite*
**/*.db
**/*.log
**/account.json
**/mcp.config.json
**/credentials*
**/chrome-profile/
